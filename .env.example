# Optional: what this project calls itself when registering with a server.
# Defaults to "vollna-scraper" if unset.
PROJECT_NAME=general-vollna-search

# Telegram alerts: when watching stops on an error, a bot messages this chat. The token comes from
# @BotFather; the chat id is your user id or a group id (a group id starts with "-").
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
