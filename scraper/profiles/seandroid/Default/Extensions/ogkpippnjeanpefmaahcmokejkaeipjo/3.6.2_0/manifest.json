{
   "action": {
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content_script.js", "inject.js" ],
      "matches": [ "https://upwork.com/*", "https://www.upwork.com/*", "https://www.vollna.com/*" ],
      "run_at": "document_start"
   }, {
      "js": [ "profile_inject.js" ],
      "matches": [ "https://www.upwork.com/freelancers/*" ],
      "run_at": "document_start"
   } ],
   "description": "Automate Upwork Bidding with AI, job filters, instant alerts, autofill proposals, A/B test cover letters, & comprehensive analytics",
   "externally_connectable": {
      "ids": [ "mekfbokliigikmolhcoecncgckhbmimj" ],
      "matches": [ "https://*.upwork.com/*", "https://www.vollna.com/*" ]
   },
   "host_permissions": [ "*://upwork.com/*", "*://*.upwork.com/*", "https://www.vollna.com/*" ],
   "icons": {
      "128": "icons/128x.png",
      "16": "icons/16x.png",
      "32": "icons/32x.png",
      "48": "icons/48x.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Upwork Copilot - AI Proposals, Filters, Instant Alerts, auto-bidding",
   "permissions": [ "cookies", "storage", "tabs", "activeTab" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "3.6.2",
   "web_accessible_resources": [ {
      "matches": [ "https://www.vollna.com/*", "https://upwork.com/*", "https://*.upwork.com/*" ],
      "resources": [ "injected.js", "b_index.js", "styles/b_index.css", "profile_sync.js" ]
   } ]
}
